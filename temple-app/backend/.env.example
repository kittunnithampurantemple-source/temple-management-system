# ---------- App ----------
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# ---------- Database ----------
# Local Postgres (docker-compose)
DATABASE_URL=postgresql://temple_user:temple_pass@localhost:5432/temple_db?schema=public
# When migrating to Supabase, just swap this connection string -
# the Prisma schema uses plain Postgres types/UUIDs so no model changes are needed.

# ---------- JWT ----------
JWT_ACCESS_SECRET=change_this_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

# ---------- Razorpay ----------
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxx

# ---------- SMTP (Nodemailer) ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM_NAME=Sree Temple Trust
SMTP_FROM_EMAIL=noreply@yourtemple.org

# ---------- Storage ----------
# local | supabase  (abstraction layer reads this to pick a driver)
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./uploads

# Future Supabase storage config (unused while STORAGE_DRIVER=local)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=temple-receipts

# ---------- Temple Info (used on PDF receipts) ----------
TEMPLE_NAME=Sree Temple Trust
TEMPLE_ADDRESS=Tripunithura, Kerala, India
TEMPLE_PHONE=+91-9999999999
TEMPLE_EMAIL=info@yourtemple.org
